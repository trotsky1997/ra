# Sample Ra config — drop me at ~/.ra.toml or pass --config

version = 1

# ─── Run / data dirs ────────────────────────────────────────────────
[run]
banner = true
# data_dir = "~/.local/share/ra"   # ATIF + ATOF root
# default_cwd = "."

# ─── Observability ──────────────────────────────────────────────────
[obs]
backend = "stderr"                 # stderr | file | otel | none
# otel_endpoint = "http://localhost:4318"

# ─── Models ─────────────────────────────────────────────────────────
[model]
default = "pi"                     # picks one of [[models]] below

[[models]]
name        = "pi"
backend     = "openai"
model_id    = "gpt-5.5"
base_url    = "https://pi-api-us.macaron.xin/v1/"
api_key_env = "PI_API_KEY"

[[models]]
name        = "anthropic"
backend     = "anthropic"
model_id    = "claude-opus-4-5"
api_key_env = "ANTHROPIC_API_KEY"

# ─── Tools allow-list (empty = all builtins enabled) ────────────────
# Available builtins:
#   read   — read a file (ACP fs reverse-call when host editor is connected)
#   write  — write a file
#   edit   — replace a literal substring inside a file (Claude Code shape)
#   bash   — run a shell command (ACP terminal reverse-call when available)
# Shell-native commands such as grep/find/ls go through bash rather
# than separate built-in tool wrappers.
# An empty list (or omitted section) ships every built-in tool.
[tools]
# builtin = ["read", "write", "edit", "bash"]
builtin = []

# ─── Skills (agentskills.io v1) ─────────────────────────────────────
# Native skills.sh (https://github.com/vercel-labs/skills) integration:
# `discover = true` (default) auto-loads SKILL.md files from
#   ./.ra/skills/                 — project-local Ra skills
#   ~/.ra/skills/                 — user-global Ra skills
#   ./.agents/skills/             — cross-agent project layout
#                                   (matches `npx skills add ... -a universal`)
#   ~/.agents/skills/             — cross-agent global layout
# Anything else (per-agent `.claude/skills/`, catalog-style
# `skills/.curated/`, …) goes in `paths` explicitly.
[skills]
enabled = true
discover = true
paths = []
# paths = ["./.claude/skills/**/SKILL.md"]   # opt-in per-agent layouts

# ─── Prompt templates → slash commands ──────────────────────────────
[prompts]
enabled = true
paths = [
  "./prompts/*.md",
  "~/.ra/prompts/*.md",
]

# ─── AGENTS.md auto-discovery (agents.md) ───────────────────────────
[agents_md]
enabled = true

# ─── A2A (server + remote agents) ───────────────────────────────────
[a2a.serve]
http_port = 3000
grpc_port = 50051

# [[a2a.remote_agents]]
# name = "helper"
# url  = "http://localhost:3001"
# auth.bearer_env = "HELPER_TOKEN"

# ─── MCP servers ────────────────────────────────────────────────────
# [[mcp.servers]]
# name      = "fs"
# transport = "stdio"
# command   = "npx"
# args      = ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]

# [[mcp.servers]]
# name      = "github"
# transport = "http"
# url       = "http://localhost:3030/mcp"
# auth.bearer_env = "GH_TOKEN"

# ─── Lifecycle hooks ────────────────────────────────────────────────
# Wire format follows the Claude Code hooks spec
# (https://code.claude.com/docs/en/hooks.md): the hook receives a JSON
# payload on stdin (`hook_event_name`, `session_id`, `cwd`, `tool_name`,
# `tool_input`, `tool_response`, `prompt`, …) and may print a JSON
# decision on stdout (top-level `decision: "block"` + `reason`,
# `hookSpecificOutput.permissionDecision: "deny"`,
# `hookSpecificOutput.additionalContext`, `continue: false` + `stopReason`).
# Exit code 2 also blocks; stderr becomes the reason.
#
# Legacy snake_case keys (`pre_tool_use`, `post_tool_use`,
# `user_prompt_submit`, `agent_end`) and `timeout_s` are still accepted
# as aliases for backwards-compatibility.

# [[hooks.PreToolUse]]
# matcher = "bash"             # regex against tool name
# command = "./hooks/audit.sh"
# timeout = 2                  # seconds; default 60
# run_async = false

# [[hooks.PostToolUse]]
# matcher = ".*"
# command = "./hooks/log.sh"

# [[hooks.UserPromptSubmit]]
# matcher = ".*"
# command = "./hooks/sanitize.sh"

# [[hooks.Stop]]
# matcher = ".*"
# command = "./hooks/cleanup.sh"

# ─── Session ────────────────────────────────────────────────────────
[session]
mode = "default"                   # default | plan | ask
# trajectory_dir = "~/.local/share/ra/sessions"

# ─── Plain-text resources (system prompt files) ─────────────────────
# [resources]
# system_prompt_path = "./prompts/system.md"
# append_system_prompt_paths = ["./prompts/style.md"]

# ─── RTK (Rust Token Killer) ───────────────────────────────────────
# Native integration with https://github.com/rtk-ai/rtk: when enabled,
# every bash command is offered to `rtk rewrite` first; if RTK has a
# recipe for that command, the rewritten form is what actually runs and
# the model sees RTK's token-compressed output instead of the raw
# verbose stream.
# Default mode is "auto" (use rtk if it's on PATH, transparent
# fallthrough otherwise); set to "on" to require it (warn on missing),
# or "off" to disable it even when installed.
# [rtk]
# mode = "auto"                    # auto | on | off (or true / false)
# binary = "/usr/local/bin/rtk"    # override PATH lookup
# ultra_compact = false            # pass --ultra-compact to rtk rewrite
