# Sample Ra config — drop me at ~/.ra.toml or pass --config

version = 1

# ─── Run / data dirs ────────────────────────────────────────────────
[run]
banner = true
# data_dir = "~/.local/share/ra"   # ATIF + ATOF root
# default_cwd = "."

# ─── Observability ──────────────────────────────────────────────────
[obs]
backend = "stderr"                 # stderr | file | otel | none
# otel_endpoint = "http://localhost:4318"

# ─── Models ─────────────────────────────────────────────────────────
[model]
default = "pi"                     # picks one of [[models]] below

[[models]]
name        = "pi"
backend     = "openai"
model_id    = "gpt-5.5"
base_url    = "https://pi-api-us.macaron.xin/v1/"
api_key_env = "PI_API_KEY"

[[models]]
name        = "anthropic"
backend     = "anthropic"
model_id    = "claude-opus-4-5"
api_key_env = "ANTHROPIC_API_KEY"

# ─── Tools allow-list (empty = all builtins enabled) ────────────────
# Available builtins:
#   read   — read a file (ACP fs reverse-call when host editor is connected)
#   write  — write a file
#   edit   — replace a literal substring inside a file (Claude Code shape)
#   bash   — run a shell command (ACP terminal reverse-call when available)
#   ast_grep — structural code search via ast-grep / verified sg alias
#   git    — run native git with argv-safe arguments
#   gh     — run native GitHub CLI with argv-safe arguments
#   grep   — structured text search
#   glob   — structured file discovery
#   ls     — structured directory listing
#   fuzzy  — non-interactive fuzzy filtering/ranking
#   apply_patch — controlled git-apply wrapper for unified diffs
#   webfetch_fetch — fetch one page as Markdown via webfetch-cli
#   webfetch_crawl — crawl bounded docs as Markdown via webfetch-cli
# An empty list (or omitted section) ships every built-in tool.
[tools]
# builtin = ["read", "write", "edit", "bash", "ast_grep", "git", "gh", "grep", "glob", "ls", "fuzzy", "apply_patch", "webfetch_fetch", "webfetch_crawl"]
builtin = []

# ─── Skills (Claude Code / agentskills.io) ──────────────────────────
# Native skills.sh (https://github.com/vercel-labs/skills) and
# Claude Code-compatible skill integration:
# `discover = true` (default) auto-loads SKILL.md files from
#   ./.ra/skills/                 — project-local Ra skills
#   ~/.ra/skills/                 — user-global Ra skills
#   ./.agents/skills/             — cross-agent project layout
#                                   (matches `npx skills add ... -a universal`)
#   ~/.agents/skills/             — cross-agent global layout
#   ./.claude/skills/             — Claude Code project skills
#   ~/.claude/skills/             — Claude Code personal skills
# Other catalog-style layouts (`skills/.curated/`, …) go in `paths`
# explicitly.
[skills]
enabled = true
discover = true
paths = []
# paths = ["./skills/.curated/**/SKILL.md"]  # opt-in extra layouts

# ─── Prompt templates → slash commands ──────────────────────────────
[prompts]
enabled = true
paths = [
  "./prompts/*.md",
  "~/.ra/prompts/*.md",
]

# ─── AGENTS.md auto-discovery (agents.md) ───────────────────────────
[agents_md]
enabled = true

# ─── OpenSpec (spec-driven development) ─────────────────────────────
# Native https://github.com/Fission-AI/OpenSpec support. When enabled
# (default), Ra finds the nearest `openspec/` directory (walking cwd up
# to the git root, like AGENTS.md) and folds a catalog of its capability
# specs and active changes into the system prompt with progressive
# disclosure — the model sees names, requirement counts, and task
# progress, then `read`s the underlying spec.md / proposal.md / tasks.md
# on demand. Ra consumes the convention; it does not reimplement the
# `openspec` CLI.
[openspec]
enabled = true
# path = "./docs/openspec"   # override the auto-discovered location
# agent_own = true           # fold the non-interactive, no-human-in-the-loop
                             # spec-driven playbook (drive the `openspec` CLI:
                             # init --tools / new change / status+instructions
                             # --json / validate --strict / archive -y) into
                             # the prompt. Set false for catalog only.

# ─── Graphify knowledge graph ──────────────────────────────────────
# Agent-owned https://github.com/safishamsi/graphify support. When enabled
# (default), Ra targets the nearest `graphify-out/graph.json` (walking cwd
# up to the git root), detects missing/stale/invalid graphs, folds an R2A
# graph workflow into the system prompt, and registers graphify_ensure /
# graphify_impact / graphify_update plus native query/path/explain tools.
# The default update path is AST-only and local; semantic extraction must be
# requested explicitly because it may use an LLM backend.
[graphify]
enabled = true
discover = true
# path = "./graphify-out/graph.json"   # override; dirs imply graph.json

# ─── A2A (server + remote agents) ───────────────────────────────────
[a2a.serve]
http_port = 3000
grpc_port = 50051

# [[a2a.remote_agents]]
# name = "helper"
# url  = "http://localhost:3001"
# auth.bearer_env = "HELPER_TOKEN"

# ─── MCP servers ────────────────────────────────────────────────────
# [[mcp.servers]]
# name      = "fs"
# transport = "stdio"
# command   = "npx"
# args      = ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]

# [[mcp.servers]]
# name      = "github"
# transport = "http"
# url       = "http://localhost:3030/mcp"
# auth.bearer_env = "GH_TOKEN"

# ─── Lifecycle hooks ────────────────────────────────────────────────
# Wire format follows the Claude Code hooks spec
# (https://code.claude.com/docs/en/hooks.md): the hook receives a JSON
# payload on stdin (`hook_event_name`, `session_id`, `cwd`, `tool_name`,
# `tool_input`, `tool_response`, `prompt`, …) and may print a JSON
# decision on stdout (top-level `decision: "block"` + `reason`,
# `hookSpecificOutput.permissionDecision: "deny"`,
# `hookSpecificOutput.additionalContext`, `continue: false` + `stopReason`).
# Exit code 2 also blocks; stderr becomes the reason.
#
# Legacy snake_case keys (`pre_tool_use`, `post_tool_use`,
# `user_prompt_submit`, `agent_end`) and `timeout_s` are still accepted
# as aliases for backwards-compatibility.

# [[hooks.PreToolUse]]
# matcher = "bash"             # regex against tool name
# command = "./hooks/audit.sh"
# timeout = 2                  # seconds; default 60
# run_async = false

# [[hooks.PostToolUse]]
# matcher = ".*"
# command = "./hooks/log.sh"

# [[hooks.UserPromptSubmit]]
# matcher = ".*"
# command = "./hooks/sanitize.sh"

# [[hooks.Stop]]
# matcher = ".*"
# command = "./hooks/cleanup.sh"

# ─── Session ────────────────────────────────────────────────────────
[session]
mode = "default"                   # default | plan | ask
# trajectory_dir = "~/.local/share/ra/sessions"

# ─── Plain-text resources (system prompt files) ─────────────────────
# [resources]
# system_prompt_path = "./prompts/system.md"
# append_system_prompt_paths = ["./prompts/style.md"]

# ─── RTK (Rust Token Killer) ───────────────────────────────────────
# Native integration with https://github.com/rtk-ai/rtk: when enabled,
# every bash command is offered to `rtk rewrite` first; if RTK has a
# recipe for that command, the rewritten form is what actually runs and
# the model sees RTK's token-compressed output instead of the raw
# verbose stream.
# Default mode is "auto" (use rtk if it's on PATH, transparent
# fallthrough otherwise); set to "on" to require it (warn on missing),
# or "off" to disable it even when installed.
# [rtk]
# mode = "auto"                    # auto | on | off (or true / false)
# binary = "/usr/local/bin/rtk"    # override PATH lookup
# ultra_compact = false            # pass --ultra-compact to rtk rewrite

# ─── openlsp (LSP code intelligence) ───────────────────────────────
# Native integration with https://github.com/trotsky1997/openlsp: when
# enabled (default), Ra registers a built-in `lsp` tool that invokes
# openlsp-cli with argv flags (diagnostics, goToDefinition, hover,
# references, format, analyze). The tool is silently omitted if no
# openlsp-cli binary can be resolved.
# Resolution order: [openlsp] binary → `openlsp-cli` on PATH →
#                   `openlsp` (alias) → `bunx openlsp-cli`
# [openlsp]
# enabled = true
# binary = "/usr/local/bin/openlsp-cli"  # override PATH lookup
# workspace_root = "."                   # passed as --workspace-root
# timeout = 30.0                         # per-call timeout in seconds

# Example: auto-run diagnostics after every write/edit via PostToolUse hook
# [[hooks.PostToolUse]]
# matcher = "write|edit"
# command = "openlsp-cli lsp --operation diagnostics --file \"$RA_TOOL_INPUT_PATH\" --json"
# timeout = 10
